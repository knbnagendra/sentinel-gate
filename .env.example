# Alpaca paper trading account (dedicated to this competition -- do not reuse)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER_TRADE=true

# Restrict the official Alpaca MCP server to read-only categories -- "trading"
# is deliberately excluded (it bundles order placement AND positions/get_orders).
# Sentinel Gate never lets Claude place orders through the MCP server directly --
# see agent/risk_gates.py + agent/execute.py for why. Real category names per
# Alpaca's docs: account, trading, watchlists, assets, stock-data, crypto-data,
# options-data, corporate-actions, news, fixed-income-data, index-data.
ALPACA_TOOLSETS=account,assets,stock-data,options-data,corporate-actions,news,watchlists,index-data

# Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-5

# Strategy / risk gate tuning
WATCHLIST=SPY,QQQ,IWM,DIA,XLF,XLE,XLK,XLV,XLY,XLI,XLP,XLU,XLB,XLC,TQQQ,SQQQ,SOXL,UVXY,VXX,AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,NFLX,ORCL,CRM,ADBE,AMD,INTC,QCOM,MU,AVGO,ARM,SMH,JPM,BAC,V,MA,GS,MS,WFC,C,RIVN,LCID,F,GM,LLY,UNH,JNJ,ABBV,MRNA,XOM,CVX,COP,WMT,COST,HD,NKE,MCD,SBUX,BA,CAT,GE,DIS,COIN,PLTR,MSTR,SOFI,GME,RBLX,UBER,PYPL,SHOP,SMCI,PANW
DAILY_LOSS_LIMIT_PCT=5
MAX_POSITION_PCT=10
MAX_CONCURRENT_POSITIONS=6
COOLDOWN_MINUTES=30
CYCLE_MINUTES=15

# Code-enforced stop-loss/take-profit, checked every cycle independent of
# Claude's judgment. Alpaca doesn't support OCO/bracket orders for options
# (verified against their docs -- only "simple"/"mleg" order classes apply
# to options), so this is the equivalent safety net instead of an
# order-level OCO. Values are % unrealized P&L on a position.
STOP_LOSS_PCT=-50
TAKE_PROFIT_PCT=100
PARTIAL_TAKE_PROFIT_PCT=50
PARTIAL_TAKE_PROFIT_CLOSE_FRACTION=50
# How often the fast protective sweep checks positions, independent of
# CYCLE_MINUTES -- the real backstop for 0DTE, which moves too fast for a
# 15-min reasoning cadence alone to react to.
PROTECTIVE_CHECK_SECONDS=15
# 0DTE allowed by default (0) -- paper trading scored on P&L, not real
# capital, so the symmetric variance of 0DTE gamma is a deliberate choice.
# Raise this for a more conservative cushion instead.
MIN_DTE_DAYS=0

# Dashboard
DASHBOARD_PORT=8501
