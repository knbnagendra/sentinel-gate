# Alpaca paper trading account (dedicated to this competition -- do not reuse)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER_TRADE=true

# Restrict the official Alpaca MCP server to read-only categories -- "trading"
# is deliberately excluded (it bundles order placement AND positions/get_orders).
# Sentinel Gate never lets Claude place orders through the MCP server directly --
# see agent/risk_gates.py + agent/execute.py for why. Real category names per
# Alpaca's docs: account, trading, watchlists, assets, stock-data, crypto-data,
# options-data, corporate-actions, news, fixed-income-data, index-data.
ALPACA_TOOLSETS=account,assets,stock-data,options-data,corporate-actions,news,watchlists,index-data

# Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-5

# Strategy / risk gate tuning
WATCHLIST=SPY,QQQ,IWM,DIA,XLF,XLE,XLK,AAPL,NVDA,MSFT,TSLA,AMZN,META,GOOGL,NFLX,AMD,JPM,BAC,DIS,COIN
DAILY_LOSS_LIMIT_PCT=5
MAX_POSITION_PCT=10
MAX_CONCURRENT_POSITIONS=6
COOLDOWN_MINUTES=30
CYCLE_MINUTES=15

# Dashboard
DASHBOARD_PORT=8501
